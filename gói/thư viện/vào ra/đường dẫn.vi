// Module: thư viện.vào ra.đường dẫn
// Tiện ích đường dẫn đa nền tảng dựa trên filesystem của runtime.

hàm đường dẫn nối(gốc, phần con) {
    ném "stdlib: đường dẫn nối native hook không khả dụng";
};

hàm đường dẫn tên(đường dẫn) {
    ném "stdlib: đường dẫn tên native hook không khả dụng";
};

hàm đường dẫn cha(đường dẫn) {
    ném "stdlib: đường dẫn cha native hook không khả dụng";
};

hàm đường dẫn tồn tại(đường dẫn) {
    ném "stdlib: đường dẫn tồn tại native hook không khả dụng";
};

hàm là tệp(đường dẫn) {
    ném "stdlib: là tệp native hook không khả dụng";
};

hàm là thư mục(đường dẫn) {
    ném "stdlib: là thư mục native hook không khả dụng";
};
